define b = Character("Бариста", color="#f5e4b8")
define a = Character("Андрей", color="#8fd3ff")
define l = Character("Лена", color="#ffb3d9")
define o = Character("Олег", color="#cccccc")
define n = Character(None)

init python:
    left_pos = Position(xpos=0.25, xanchor=0.5, ypos=1.0, yanchor=1.0)
    right_pos = Position(xpos=0.75, xanchor=0.5, ypos=1.0, yanchor=1.0)

image bg cafe_day = "bg_cafe_day.jpg"
image bg cafe_night = "bg_cafe_night.jpg"
image bg street = "bg_street.jpg"

image lena calm = "lena_calm.png"
image lena inspired = "lena_inspired.png"

image andrey normal = "andrey_normal.png"
image oleg normal = "oleg_normal.png"

define audio.cafe_day_theme = "cafe_day_theme.ogg"
define audio.cafe_night_theme = "cafe_night_theme.ogg"
define audio.street_night = "street_night.ogg"

default andrey_leave = False
default lena_art = False
default barista_attached = False

label start:

    scene bg cafe_day with fade
    play music cafe_day_theme fadein 2.0

    n "Вечер тянулся как остывший кофе."
    n "Кафе на перекрёстке почти опустело, только неон за окном моргал в такт моему зевку."
    b "Ещё один тихий день. И слава богу."

    n "Я уже тянулся к выключателю, когда дверь звякнула колокольчиком."

    show andrey normal at right_pos with moveinright

    a "Добрый вечер... Вы ещё работаете?"
    b "Для тех, кто зашёл в последний момент, у нас всегда найдётся кружка кофе."

    a "Тогда двойной эспрессо. Надо проснуться, пока не стало слишком поздно."


    n "Он сел у стойки, поставил рядом небольшой чемодан и задумчиво уставился в окно."

    b "Командировка?"
    a "Скорее, бегство."

    a "Работа, город, всё это — будто чужое. Вот думаю: купить билет в один конец или вернуться обратно, как всегда."

    menu:
        "Что сказать Андрею?":
            "Иногда надо рискнуть, чтобы не жалеть потом.":
                $ andrey_leave = True
                b "Иногда хуже, чем уехать, только одно — остаться и всю жизнь думать \"а что, если бы я попробовал\"."
                a "Вы так легко об этом говорите."
                b "Я просто наливаю кофе. Но иногда этого достаточно, чтобы человек решился."
                a "Забавно. Возможно, вы только что решили вместо меня."
            "Бегство не всегда решает проблему.":
                $ andrey_leave = False
                b "Куда бы ты ни уехал, чемодан проблем всегда едет с тобой. Иногда лучше разгрести завалы, чем сбегать от них."
                a "Звучит слишком разумно для ночного бариста."
                b "Ночью люди говорят честнее. Даже те, кто просто льёт кофе."
                a "Может, вы правы. Может, ещё рано сжигать мосты."

    a "Спасибо за кофе. Что бы я ни выбрал — этот вечер запомню."
    hide andrey normal with dissolve

    n "Он ушёл, оставив только след от кружки на столе."

    scene bg cafe_night with dissolve
    stop music fadeout 1.5
    play music cafe_night_theme fadein 2.0

    n "Ночь окончательно вступила в свои права."
    n "Кафе погрузилось в мягкий полумрак, только лампа над стойкой цеплялась за остатки света."

    show lena calm at left_pos with moveinleft

    l "Вы ещё не закрылись? Мне сказали, здесь можно посидеть, даже если уже поздно."
    b "Можешь. Тут время иногда забывает идти по расписанию."

    l "Тогда латте, пожалуйста. И... если можно, я кое-что покажу."

    n "Она достала из сумки папку с рисунками. На лицевой — ночные улицы, люди в свете витрин, такие же усталые, как я."

    l "Скажите честно... Это хоть что-то стоит? Я думаю уйти с работы и заняться этим всерьёз."

    show lena calm at left_pos with dissolve

    menu:
        "Что сказать Лене?":
            "Если ты сияешь, когда рисуешь — пробуй.":
                $ lena_art = True
                b "Когда ты говоришь о рисунках, у тебя глаза загораются сильнее, чем у наших ламп над стойкой."
                b "Если можешь жить без этого — живи. Если нет — у тебя и так нет выбора."
                show lena inspired at left_pos with dissolve
                l "Вы первый, кто сказал это так прямо."
                l "Может быть, мне правда пора перестать только мечтать."
            "Талант — это здорово, но думай о стабильности.":
                $ lena_art = False
                b "Талант — это прекрасно. Но аренда, еда и всё остальное талантом не оплачиваются."
                b "Можно рисовать и после работы, не ломая жизнь через колено."
                show lena calm at left_pos with dissolve
                l "Наверное, вы правы. Глупо все бросать из-за нескольких рисунков."
                l "Но почему-то от этих слов немного больно."

    l "Спасибо за кофе... и за честность."
    hide lena calm
    hide lena inspired
    with dissolve

    n "Когда дверь за ней закрылась, мне показалось, что в кафе стало чуть темнее."

    stop music fadeout 1.5
    play music street_night fadein 2.0

    scene bg street with blinds

    n "Я вышел выкурить сигарету к двери. Ночной перекрёсток жил своей тихой жизнью: редкие фары, ветер, шуршание листьев."

    show oleg normal at right_pos with moveinright

    o "Опять работаешь до ночи, сынок?"
    b "Кто-то же должен поить этих странных людей кофе."

    o "Странные люди — это хорошо. Значит, у них ещё есть о чём думать."
    o "Слышал, говорят, ваше кафе скоро продадут. Не жалеешь, что связался с этим местом?"

    menu:
        "Как относишься к кафе?":
            "Это просто работа, ничего больше.":
                $ barista_attached = False
                b "Честно? Это просто точка на карте. Люди приходят, уходят, а я меняю кружки."
                o "Хм. Тогда тебе будет проще, когда вывеска погаснет."
                o "Не всем везёт найти место, к которому привязываешься."
            "Это часть меня и всех, кто сюда приходит.":
                $ barista_attached = True
                b "Это маленький мир на перекрёстке. Здесь люди решают, куда им дальше — налево, направо или назад."
                b "Если вывеска погаснет, всё равно останется то, что здесь говорили друг другу."
                o "Значит, было не зря."
                o "Редко встретишь кого-то, кто так говорит о своей работе."

    o "Ладно, не буду мешать. Завтра, может, ещё загляну — если дверь будет открыта."
    hide oleg normal with dissolve

    n "Он медленно ушёл по ночной улице, растворяясь в свете фонарей."


    scene bg cafe_night with fade
    stop music fadeout 2.0

    n "Я вернулся внутрь. Кафе было пустым, только часы над дверью тихо отсчитывали секунды."

    if andrey_leave and lena_art and barista_attached:
        jump ending_warm
    elif (not andrey_leave) and (not lena_art) and (not barista_attached):
        jump ending_cold
    else:
        jump ending_close


label ending_warm:

    play music cafe_night_theme fadein 2.0

    n "Где-то там Андрей, возможно, уже сидел в поезде."
    n "Лена, может быть, стояла над чистым холстом и впервые не боялась ошибиться."

    n "А я... Я просто протирал стойку и ждал следующего гостя."

    b "Пока горит свет над дверью — у кого-то ещё есть шанс выбрать другой путь."

    n "Вывеска над входом вспыхнула ярче, отражаясь в мокром асфальте перекрёстка."

    n "Кафе на перекрёстке судеб продолжало работать."

    n "{size=30}КОНЦОВКА: ТЁПЛЫЙ СЛЕД{/size}"

    return


label ending_cold:

    play music street_night fadein 2.0

    n "Андрей, скорее всего, снова придёт в тот же офис."
    n "Лена завтра пойдёт на ту же работу, спрятав папку с рисунками глубже в сумку."

    n "Кафе тоже останется таким же. Только в его тишине что-то надломится."

    b "Просто работа. Просто люди. Просто кофе."

    n "Вывеска над дверью продолжала мерцать, как будто не могла решиться — гореть или погаснуть."

    n "{size=30}КОНЦОВКА: СТАБИЛЬНОСТЬ ЛЮБОЙ ЦЕНОЙ{/size}"

    return


label ending_close:

    play music street_night fadein 2.0

    n "Не все решения бывают правильными или неправильными."
    n "Иногда они просто разные, и жить с ними приходится по-своему."

    n "Говорят, через месяц на этом месте откроют другое заведение."
    n "Никаких кофейных зерен в витрине, никаких ночных разговоров — просто ещё одна точка на карте."

    n "Но перекрёсток останется. Дороги по-прежнему будут расходиться в разные стороны."

    n "{size=30}КОНЦОВКА: ЗАКРЫТЫЕ ДВЕРИ{/size}"

    return